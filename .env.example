# ============================================
# Smart Plant Care System — Environment Config
# ============================================
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# --- Supabase (Frontend-accessible via VITE_ prefix) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (Server-side only — used in /api serverless functions) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini AI (Server-side only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ThingSpeak (Server-side only) ---
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=

# --- Stale Reading Configuration (seconds) ---
STALE_THRESHOLD_SECONDS=120
OFFLINE_THRESHOLD_SECONDS=300
