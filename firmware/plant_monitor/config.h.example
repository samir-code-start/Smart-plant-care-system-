// ============================================
// Smart Plant Care System — ESP8266 Configuration
// ============================================
// Copy this file to config.h and fill in your credentials.
// config.h is gitignored — NEVER commit it.
// ============================================

#ifndef CONFIG_H
#define CONFIG_H

// --- WiFi Credentials ---
#define WIFI_SSID "Your_WiFi_SSID"
#define WIFI_PASSWORD "Your_WiFi_Password"

// --- ThingSpeak Configuration ---
#define THINGSPEAK_CHANNEL_ID 0000000UL
#define THINGSPEAK_WRITE_API_KEY "YOUR_WRITE_API_KEY"

// --- Sensor Calibration ---
// Measure these with YOUR specific sensor:
//   ADC_AIR_VALUE: ADC reading when sensor is in dry air (0% moisture)
//   ADC_WATER_VALUE: ADC reading when sensor is submerged in water (100% moisture)
// These are PLACEHOLDER values — calibrate before trusting readings!
const int ADC_AIR_VALUE = 820;      // Typical dry-air reading (high)
const int ADC_WATER_VALUE = 350;    // Typical water-submerged reading (low)

// --- Reporting Interval ---
// ThingSpeak free tier requires minimum 15s between updates.
// 30 seconds is a safe default.
const unsigned long REPORT_INTERVAL_MS = 30000;

// --- Oversampling ---
// Number of ADC samples to average per reading (noise reduction).
const int ADC_SAMPLE_COUNT = 10;
const int ADC_SAMPLE_DELAY_MS = 50;

// --- Active Plant ID ---
// Numeric ID sent to ThingSpeak Field 3 to identify which plant
// the sensor is currently monitoring.
// 1=Tomato, 2=Basil, 3=Aloe Vera, 4=Money Plant, 5=Mint, 6=Rose, 7=Cucumber
const int ACTIVE_PLANT_ID = 1;

#endif // CONFIG_H
